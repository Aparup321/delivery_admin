# -----------------------------------------------------------------------------
# Firebase web-app connection for delivery_admin
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from the SAME Firebase
# project that delivery_app uses:
#
#   Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
#   and configuration
#
# `.env.local` is gitignored. Values prefixed with VITE_ are exposed to the
# browser bundle. A Firebase web API key is a public project identifier, not a
# server secret. Never place service-account keys or Admin SDK private keys
# here: protect data with Firestore security rules and restrict the API key by
# HTTP referrer in Google Cloud Console.
#
# Restart `npm run dev` after editing this file; Vite reads env files at startup.
# -----------------------------------------------------------------------------

# Required for the Firestore partner sync.
VITE_FIREBASE_PROJECT_ID=

# Required when Firestore security rules allow the public web API key.
VITE_FIREBASE_API_KEY=

# Optional. Leave as (default) for the default Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Optional. Collection written by delivery_app. Default: partners.
VITE_FIREBASE_PARTNERS_COLLECTION=partners

# Optional standard Firebase web-app values (not used by the REST sync today,
# but available if Firebase Auth or Storage is added later).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
